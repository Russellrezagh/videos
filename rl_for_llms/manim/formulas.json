{
  "J": "J(\\theta) = \\sum_a \\pi_\\theta(a)\\, r_a",
  "floor": "u = z_{51} - z_{41}, \\qquad v = z_{\\approx 50} - z_{41}",
  "grad": "\\nabla J",
  "sample": "\\hat g = r_a\\, \\nabla \\log \\pi_\\theta(a)",
